{
  "name": "visual-editor-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.editor.config.ts",
    "build": "tsc --noEmit && vite build --config vite.editor.config.ts && vite build --config vite.runtime.config.ts",
    "build:fast": "vite build --config vite.editor.config.ts && vite build --config vite.runtime.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.3",
    "@codemirror/theme-one-dark": "^6.1.2",
    "codemirror": "^6.0.1",
    "html-to-image": "^1.11.11",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sucrase": "^3.35.0",
    "tailwindcss": "^4.1.4",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.2.6"
  }
}
